datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Application {
  id                    Int               @id @default(autoincrement())
  jobTitle              String
  companyName           String
  location              String?
  employmentType        EmploymentType?
  salary                String?
  dateApplied           DateTime?
  source                String?
  applicationMethod     String?
  requirementsShortlist String?
  status                ApplicationStatus @default(NO_RESPONSE)
  includedCoverLetter   Boolean           @default(false)
  urlToJobPosting       String?
  sourceUrl             String?
  rawPostingText        String?
  autoExtracted         Boolean           @default(false)
  importSourceType      ImportSourceType? @default(MANUAL)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  interviews Interview[]
  notes      Note[]
}

model Interview {
  id              Int         @id @default(autoincrement())
  application     Application @relation(fields: [applicationId], references: [id])
  applicationId   Int
  round           Int?
  title           String?
  startDateTime   DateTime?
  endDateTime     DateTime?
  location        String?
  notes           String?
  calendarEventId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Note {
  id            Int         @id @default(autoincrement())
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId Int
  content       String
  createdAt     DateTime    @default(now())
}

enum EmploymentType {
  REMOTE
  HYBRID
  ONSITE
}

enum ApplicationStatus {
  NO_RESPONSE
  FIRST_INTERVIEW
  SECOND_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTED
  ACCEPTED
}

enum ImportSourceType {
  URL
  FILE
  IMAGE
  MANUAL
}
